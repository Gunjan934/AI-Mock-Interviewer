flowchart LR
    subgraph FRONT[Frontend — Jinja2 templates + Bootstrap 5 CDN + Inter font + custom CSS/JS]
        WEB[app/templates + app/static]
    end

    subgraph FACTORY[Flask application — run.py → create_app]
        FACT[config, extensions, blueprints, /health]
    end

    subgraph ROUTES[Flask blueprints — app/routes]
        AUTH[auth]
        PROFILE[profile]
        RESUME[resume]
        JD[jd]
        QUESTIONS[questions]
        INTERVIEW[interview]
        DASH[dashboard]
        AIPLAY[ai]
        KNOWLEDGE[knowledge]
        CAREER[career_guidance]
        ERR[errors]
    end

    subgraph SERVICES[Business logic — app/services + app/nlp]
        EVALSVC[evaluation_service — baseline_v1, ai_v1]
        INTVSVC[interview_service — bank pick, adaptive rule, AI orchestration]
        RESUMESVC[resume_service — pypdf extraction + heuristics]
        JDSVC[jd_service — lexical extraction + profile match]
        CTX[candidate_context — user-scoped AI context]
        KBSVC[knowledge_service — RAG ingestion]
        NPREP[nlp.preprocessing, nlp.similarity]
    end

    subgraph AI[app/ai — NVIDIA stack]
        CLIENT[AIService — facade, typed errors, JSON validation]
        PROV[NvidiaProvider — urllib, retries, timeouts]
        PROMPTS[prompts.registry — versioned templates]
        QGEN[services.question_gen — dynamic questions]
        AGENT[services.agent — FOLLOW_UP/CLARIFY/NEXT_QUESTION/FINISH]
        EVALAI[services.answer_eval — ai_v1 rubric + weighted overall]
        EXC[exceptions — typed errors]
    end

    subgraph ML[app/ml — Phase 4, optional, disabled by default]
        MLPRED[MLPredictor — LinearSVC, ml_v1]
    end

    subgraph RAG[app/rag — Phase 6, optional, disabled by default]
        RAGCFG[config]
        RAGLOAD[document_loader, chunking, text_cleaner]
        RAGEMB[embedding_service — sentence-transformers]
        RAGV[vector_store — ChromaDB]
        RAGR[retriever, rag_service, context_builder]
    end

    subgraph CG[app/career_guidance]
        CGCHAT[services — context_service, prompt_service, chat_service]
    end

    subgraph DB[Persistence — MySQL via SQLAlchemy/Flask-SQLAlchemy]
        MODELS[app/models — user, profile, resume, job_description, question, interview, evaluation, knowledge, career_guidance]
        MIG[Flask-Migrate — 6 revisions]
        UPLOADS[(uploads/ — PDFs)]
        VSTORE[(instance/vector_store — ChromaDB)]
    end

    subgraph NVIDIA[NVIDIA NIM — https://integrate.api.nvidia.com/v1]
        CHAT[POST /v1/chat/completions]
    end

    subgraph VERIFY[Verification — pytest]
        PYT[127 passed, 1 failed live test]
    end

    WEB --> FACT
    FACT --> ROUTES
    ROUTES --> SERVICES
    ROUTES --> DB
    ROUTES --> AI
    ROUTES --> CG
    SERVICES --> DB
    SERVICES --> AI
    SERVICES --> ML
    SERVICES --> RAG
    AI --> NVIDIA
    CG --> AI

